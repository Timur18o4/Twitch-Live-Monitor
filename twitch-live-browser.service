[Unit]
Description=Öffnet Twitch-Kanalseiten während eines Livestreams
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/twitch-live-browser/config.env
ExecStart=/usr/bin/python3 %h/.local/share/twitch-live-browser/monitor.py
Restart=on-failure
RestartSec=20
KillMode=control-group
