# Erstelle eine Anwendung unter https://dev.twitch.tv/console/apps und trage hier ihre Client ID ein.
TWITCH_CLIENT_ID=hier_eintragen_client_id

# App-Token-Modus: Client Secret hier eintragen.
TWITCH_CLIENT_SECRET=hier_eintragen_client_secret

# User-Token-Modus: Beide Tokens eintragen und die Client-Secret-Zeile oben entfernen.
# TWITCH_ACCESS_TOKEN=
# TWITCH_REFRESH_TOKEN=

# Twitch-Logins durch Kommas trennen. Für jeden Live-Kanal wird ein eigenes Browserfenster geöffnet.
TWITCH_CHANNELS=timur18o4,frau_potti

# Abstand zwischen Twitch-Statusabfragen in Sekunden (mindestens 10).
CHECK_INTERVAL_SECONDS=15
