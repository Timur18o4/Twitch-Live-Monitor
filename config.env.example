# Create an app at https://dev.twitch.tv/console/apps and set its Client ID.
TWITCH_CLIENT_ID=replace_with_your_client_id

# App-token mode: provide a Client Secret.
TWITCH_CLIENT_SECRET=replace_with_your_client_secret

# Or user-token mode: provide both tokens and remove the Client Secret line above.
# TWITCH_ACCESS_TOKEN=
# TWITCH_REFRESH_TOKEN=

# Comma-separated Twitch login names. Each live channel gets its own browser window.
TWITCH_CHANNELS=timur18o4,frau_potti

# Seconds between Twitch status checks (minimum 10).
CHECK_INTERVAL_SECONDS=15
